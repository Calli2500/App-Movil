<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PlayerActivity">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:id="@+id/content_root_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_mint"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- 1. BARRA SUPERIOR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/title_reproduciendo"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_more_options"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/text_dark" />
        </FrameLayout>

        <!-- 2. CARÁTULA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="24dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#D3F5E7"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_album_art"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/text_dark" />
        </androidx.cardview.widget.CardView>

        <!-- 3. INFORMACIÓN DE LA CANCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/song_1_title"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/song_1_artist"
                android:textColor="#4A4A4A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 4. BARRA DE TIEMPO Y PROGRESO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/seekBarSong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="0"
                android:progressTint="@color/text_dark"
                android:thumbTint="@color/text_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimeCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/time_current"
                    android:textColor="#4A4A4A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTimeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_total"
                    android:textColor="#4A4A4A"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. CONTROLES DE REPRODUCCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:contentDescription="@string/cd_shuffle"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_dark" />

            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="12dp"
                android:contentDescription="@string/cd_previous"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/text_dark" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/text_dark"
                android:contentDescription="@string/cd_play"
                android:padding="14dp"
                android:src="@android:drawable/ic_media_pause"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="12dp"
                android:contentDescription="@string/cd_next"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/text_dark" />

            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:contentDescription="@string/cd_repeat"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="@color/text_dark" />
        </LinearLayout>

        <!-- 5b. VELOCIDAD Y BUCLE A-B -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="#D3F5E7"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="14dp"
                android:text="1x"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLoopA"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="#D3F5E7"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="14dp"
                android:text="A"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLoopB"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="#D3F5E7"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="14dp"
                android:text="B"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearAB"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="#D3F5E7"
                android:clickable="true"
                android:contentDescription="Quitar bucle A-B"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="40dp"
                android:paddingHorizontal="10dp"
                android:text="✕"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 6. BARRA DE VOLUMEN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_volume_low"
                android:src="@android:drawable/ic_lock_silent_mode"
                app:tint="@color/text_dark" />

            <SeekBar
                android:id="@+id/seekBarVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/text_dark"
                android:thumbTint="@color/text_dark" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_volume_high"
                android:src="@android:drawable/ic_lock_silent_mode_off"/>
        </LinearLayout>

    </LinearLayout>

    <!-- MENÚ LATERAL OCULTO -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_player"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/menu_opciones" />

</androidx.drawerlayout.widget.DrawerLayout>