<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutFavorites"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FavoritesActivity">

    <RelativeLayout
        android:id="@+id/favoritesRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_mint"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- BARRA SUPERIOR -->
        <LinearLayout
            android:id="@+id/topBarFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/cd_menu"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/app_title"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp" />

        </LinearLayout>

        <!-- CONTENIDO -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topBarFavorites"
            android:layout_marginTop="16dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Mis favoritos"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Tu colección de canciones favoritas."
                    android:textColor="#4A4A4A"
                    android:textSize="13sp" />

                <!-- MENSAJE CUANDO NO HAY FAVORITOS -->
                <TextView
                    android:id="@+id/tvEmptyFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#D3F5E7"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Aún no tienes canciones favoritas"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- LISTA DINÁMICA DE FAVORITOS -->
                <LinearLayout
                    android:id="@+id/layoutFavoritesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>

    <!-- MENÚ LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_favorites"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/menu_opciones" />

</androidx.drawerlayout.widget.DrawerLayout>
